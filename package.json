{
  "name": "bns-vscode-theme",
  "displayName": "BNS VSCode Theme",
  "description": "A modern, visually pleasing dark and light color theme for Visual Studio Code.",
  "version": "1.0.0",
  "publisher": "MrBns",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "color-theme",
    "dark",
    "light",
    "bns",
    "theme"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "BNS Dark",
        "uiTheme": "vs-dark",
