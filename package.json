      {
        "label": "BNS Light",
        "uiTheme": "vs",
        "path": "./themes/bns-light-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBns/bns-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/MrBns/bns-vscode-theme/issues"
  },
