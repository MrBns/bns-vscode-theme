{
  "$schema": "vscode://schemas/color-theme",
  "name": "BNS Light",
  "type": "light",
  "colors": {
    // ─── Activity Bar ───────────────────────────────────────────────
    "activityBar.background": "#eff1f5",
    "activityBar.foreground": "#4c4f69",
    "activityBar.inactiveForeground": "#9ca0b0",
    "activityBar.border": "#dce0e8",
    "activityBarBadge.background": "#1e66f5",
    "activityBarBadge.foreground": "#eff1f5",

    // ─── Side Bar ────────────────────────────────────────────────────
    "sideBar.background": "#e6e9ef",
    "sideBar.foreground": "#4c4f69",
    "sideBar.border": "#dce0e8",
    "sideBarTitle.foreground": "#4c4f69",
    "sideBarSectionHeader.background": "#eff1f5",
    "sideBarSectionHeader.foreground": "#4c4f69",
    "sideBarSectionHeader.border": "#dce0e8",

    // ─── Editor ──────────────────────────────────────────────────────
    "editor.background": "#eff1f5",
    "editor.foreground": "#4c4f69",
    "editorLineNumber.foreground": "#9ca0b0",
    "editorLineNumber.activeForeground": "#4c4f69",
    "editor.selectionBackground": "#bcc0cc50",
    "editor.inactiveSelectionBackground": "#bcc0cc30",
    "editor.selectionHighlightBackground": "#bcc0cc30",
    "editor.wordHighlightBackground": "#bcc0cc30",
    "editor.wordHighlightStrongBackground": "#bcc0cc50",
    "editor.findMatchBackground": "#df8e1d40",
    "editor.findMatchHighlightBackground": "#df8e1d20",
    "editor.hoverHighlightBackground": "#bcc0cc30",
    "editor.lineHighlightBackground": "#e6e9ef",
    "editor.lineHighlightBorder": "#dce0e8",
    "editorCursor.foreground": "#ea76cb",
    "editorWhitespace.foreground": "#9ca0b080",
    "editorIndentGuide.background1": "#dce0e8",
    "editorIndentGuide.activeBackground1": "#9ca0b0",
    "editorRuler.foreground": "#dce0e8",
    "editorBracketMatch.background": "#bcc0cc50",
    "editorBracketMatch.border": "#1e66f5",
    "editorGutter.background": "#eff1f5",
    "editorGutter.addedBackground": "#40a02b",
    "editorGutter.deletedBackground": "#d20f39",
    "editorGutter.modifiedBackground": "#1e66f5",

    // ─── Editor Groups & Tabs ────────────────────────────────────────
    "editorGroup.border": "#dce0e8",
    "editorGroupHeader.tabsBackground": "#e6e9ef",
    "editorGroupHeader.noTabsBackground": "#e6e9ef",
    "tab.activeBackground": "#eff1f5",
    "tab.activeForeground": "#4c4f69",
    "tab.border": "#dce0e8",
    "tab.activeBorder": "#1e66f5",
    "tab.activeBorderTop": "#00000000",
    "tab.inactiveBackground": "#e6e9ef",
    "tab.inactiveForeground": "#9ca0b0",
    "tab.unfocusedActiveForeground": "#4c4f6960",
    "tab.unfocusedInactiveForeground": "#9ca0b080",
    "tab.hoverBackground": "#eff1f5",

    // ─── Status Bar ──────────────────────────────────────────────────
    "statusBar.background": "#e6e9ef",
    "statusBar.foreground": "#4c4f69",
    "statusBar.border": "#dce0e8",
    "statusBar.debuggingBackground": "#d20f39",
    "statusBar.debuggingForeground": "#eff1f5",
    "statusBar.noFolderBackground": "#bcc0cc",
    "statusBarItem.remoteBackground": "#1e66f5",
    "statusBarItem.remoteForeground": "#eff1f5",
    "statusBarItem.hoverBackground": "#bcc0cc50",

    // ─── Title Bar ───────────────────────────────────────────────────
    "titleBar.activeBackground": "#dce0e8",
    "titleBar.activeForeground": "#4c4f69",
    "titleBar.inactiveBackground": "#dce0e8",
    "titleBar.inactiveForeground": "#9ca0b0",
    "titleBar.border": "#dce0e8",

    // ─── Input ───────────────────────────────────────────────────────
    "input.background": "#dce0e8",
    "input.border": "#bcc0cc",
    "input.foreground": "#4c4f69",
    "input.placeholderForeground": "#9ca0b0",
    "inputOption.activeBackground": "#1e66f530",
    "inputOption.activeBorder": "#1e66f5",
    "inputValidation.errorBackground": "#d20f3920",
    "inputValidation.errorBorder": "#d20f39",
    "inputValidation.infoBackground": "#1e66f520",
    "inputValidation.infoBorder": "#1e66f5",
    "inputValidation.warningBackground": "#df8e1d20",
    "inputValidation.warningBorder": "#df8e1d",

    // ─── Buttons ─────────────────────────────────────────────────────
    "button.background": "#1e66f5",
    "button.foreground": "#eff1f5",
    "button.hoverBackground": "#209fb5",
    "button.secondaryBackground": "#bcc0cc",
    "button.secondaryForeground": "#4c4f69",
    "button.secondaryHoverBackground": "#9ca0b0",

    // ─── Dropdowns / Select ──────────────────────────────────────────
    "dropdown.background": "#dce0e8",
    "dropdown.border": "#bcc0cc",
    "dropdown.foreground": "#4c4f69",
    "dropdown.listBackground": "#eff1f5",

    // ─── Lists ───────────────────────────────────────────────────────
    "list.activeSelectionBackground": "#bcc0cc50",
    "list.activeSelectionForeground": "#4c4f69",
    "list.dropBackground": "#bcc0cc50",
    "list.focusBackground": "#bcc0cc30",
    "list.focusForeground": "#4c4f69",
    "list.highlightForeground": "#1e66f5",
    "list.hoverBackground": "#bcc0cc30",
    "list.hoverForeground": "#4c4f69",
    "list.inactiveSelectionBackground": "#bcc0cc30",
    "list.inactiveSelectionForeground": "#4c4f69",
    "list.invalidItemForeground": "#d20f39",

    // ─── Panels ──────────────────────────────────────────────────────
    "panel.background": "#e6e9ef",
    "panel.border": "#dce0e8",
    "panelTitle.activeBorder": "#1e66f5",
    "panelTitle.activeForeground": "#4c4f69",
    "panelTitle.inactiveForeground": "#9ca0b0",

    // ─── Terminal ────────────────────────────────────────────────────
    "terminal.background": "#eff1f5",
    "terminal.foreground": "#4c4f69",
    "terminal.ansiBlack": "#5c5f77",
    "terminal.ansiRed": "#d20f39",
    "terminal.ansiGreen": "#40a02b",
    "terminal.ansiYellow": "#df8e1d",
    "terminal.ansiBlue": "#1e66f5",
    "terminal.ansiMagenta": "#ea76cb",
    "terminal.ansiCyan": "#179299",
    "terminal.ansiWhite": "#acb0be",
    "terminal.ansiBrightBlack": "#6c6f85",
    "terminal.ansiBrightRed": "#d20f39",
    "terminal.ansiBrightGreen": "#40a02b",
    "terminal.ansiBrightYellow": "#df8e1d",
    "terminal.ansiBrightBlue": "#1e66f5",
    "terminal.ansiBrightMagenta": "#ea76cb",
    "terminal.ansiBrightCyan": "#179299",
    "terminal.ansiBrightWhite": "#bcc0cc",
    "terminal.selectionBackground": "#9ca0b040",
    "terminalCursor.background": "#eff1f5",
    "terminalCursor.foreground": "#ea76cb",

    // ─── Git Decorations ─────────────────────────────────────────────
    "gitDecoration.addedResourceForeground": "#40a02b",
    "gitDecoration.modifiedResourceForeground": "#1e66f5",
    "gitDecoration.deletedResourceForeground": "#d20f39",
    "gitDecoration.untrackedResourceForeground": "#40a02b",
    "gitDecoration.ignoredResourceForeground": "#9ca0b0",
    "gitDecoration.conflictingResourceForeground": "#fe640b",
    "gitDecoration.submoduleResourceForeground": "#179299",

    // ─── Diff Editor ─────────────────────────────────────────────────
    "diffEditor.insertedTextBackground": "#40a02b20",
    "diffEditor.removedTextBackground": "#d20f3920",
    "diffEditor.insertedLineBackground": "#40a02b10",
    "diffEditor.removedLineBackground": "#d20f3910",
    "diffEditor.diagonalFill": "#bcc0cc80",

    // ─── Scrollbar ───────────────────────────────────────────────────
    "scrollbar.shadow": "#dce0e8",
    "scrollbarSlider.activeBackground": "#9ca0b080",
    "scrollbarSlider.background": "#bcc0cc40",
    "scrollbarSlider.hoverBackground": "#bcc0cc60",

    // ─── Widgets ─────────────────────────────────────────────────────
    "widget.shadow": "#dce0e8",
    "editorWidget.background": "#dce0e8",
    "editorWidget.border": "#bcc0cc",
    "editorWidget.foreground": "#4c4f69",
    "editorSuggestWidget.background": "#dce0e8",
    "editorSuggestWidget.border": "#bcc0cc",
    "editorSuggestWidget.foreground": "#4c4f69",
    "editorSuggestWidget.highlightForeground": "#1e66f5",
    "editorSuggestWidget.selectedBackground": "#bcc0cc50",
    "editorHoverWidget.background": "#dce0e8",
    "editorHoverWidget.border": "#bcc0cc",

    // ─── Errors & Warnings ───────────────────────────────────────────
    "editorError.foreground": "#d20f39",
    "editorWarning.foreground": "#df8e1d",
    "editorInfo.foreground": "#1e66f5",
    "editorHint.foreground": "#179299",

    // ─── Misc ────────────────────────────────────────────────────────
    "focusBorder": "#1e66f5",
    "foreground": "#4c4f69",
    "selection.background": "#bcc0cc50",
    "descriptionForeground": "#6c6f85",
    "errorForeground": "#d20f39",
    "icon.foreground": "#4c4f69",
    "badge.background": "#1e66f5",
    "badge.foreground": "#eff1f5",
    "progressBar.background": "#1e66f5",
    "menu.background": "#dce0e8",
    "menu.foreground": "#4c4f69",
    "menu.selectionBackground": "#bcc0cc50",
    "menu.selectionForeground": "#4c4f69",
    "menu.separatorBackground": "#bcc0cc",
    "menu.border": "#bcc0cc"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#8839ef",
    "class": "#d20f39",
    "interface": "#179299",
    "struct": "#d20f39",
    "enum": "#df8e1d",
    "typeParameter": "#fe640b",
    "type": "#179299",
    "parameter": "#4c4f69",
    "variable": "#4c4f69",
    "variable.readonly": "#8839ef",
    "variable.defaultLibrary": "#1e66f5",
    "property": "#4c4f69",
    "property.declaration": "#1e66f5",
    "property.readonly": "#8839ef",
    "enumMember": "#40a02b",
    "function": "#1e66f5",
    "method": "#1e66f5",
    "macro": "#d20f39",
    "keyword": "#8839ef",
    "comment": "#9ca0b0",
    "string": "#40a02b",
    "number": "#fe640b",
    "operator": "#04a5e5",
    "decorator": "#ea76cb",
    "regexp": "#d20f39",
    "selfParameter": {
      "foreground": "#d20f39",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9ca0b0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "name": "Boolean / Null",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#04a5e5"
      }
    },
    {
      "name": "Function name",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "Function parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "name": "Class / Type",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#179299"
      }
    },
    {
      "name": "Enum",
      "scope": ["entity.name.type.enum"],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "name": "Constant",
      "scope": ["variable.other.constant", "variable.other.readonly"],
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "this / self",
      "scope": ["variable.language.this", "variable.language.self"],
      "settings": {
        "foreground": "#d20f39",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag name",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "name": "CSS Property",
      "scope": ["support.type.property-name.css", "support.type.property-name.scss"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "CSS Selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "name": "Decorator",
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": {
        "foreground": "#ea76cb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "punctuation.definition.heading.markdown"],
      "settings": {
        "foreground": "#1e66f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#df8e1d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#ea76cb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#1e66f5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "JSON Key",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": {
        "foreground": "#d20f39",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
