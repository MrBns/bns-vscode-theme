{
  "$schema": "vscode://schemas/color-theme",
  "name": "BNS Dark",
  "type": "dark",
  "colors": {
    // ─── Activity Bar ───────────────────────────────────────────────
    "activityBar.background": "#1e1e2e",
    "activityBar.foreground": "#cdd6f4",
    "activityBar.inactiveForeground": "#585b70",
    "activityBar.border": "#181825",
    "activityBarBadge.background": "#89b4fa",
    "activityBarBadge.foreground": "#1e1e2e",

    // ─── Side Bar ────────────────────────────────────────────────────
    "sideBar.background": "#181825",
    "sideBar.foreground": "#cdd6f4",
    "sideBar.border": "#11111b",
    "sideBarTitle.foreground": "#cdd6f4",
    "sideBarSectionHeader.background": "#1e1e2e",
    "sideBarSectionHeader.foreground": "#cdd6f4",
    "sideBarSectionHeader.border": "#11111b",

    // ─── Editor ──────────────────────────────────────────────────────
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editorLineNumber.foreground": "#45475a",
    "editorLineNumber.activeForeground": "#cdd6f4",
    "editor.selectionBackground": "#363659",
    "editor.inactiveSelectionBackground": "#2a2a3f",
    "editor.selectionHighlightBackground": "#2a2a4080",
    "editor.wordHighlightBackground": "#2a2a4080",
    "editor.wordHighlightStrongBackground": "#36365980",
    "editor.findMatchBackground": "#f9e2af40",
    "editor.findMatchHighlightBackground": "#f9e2af20",
    "editor.hoverHighlightBackground": "#2a2a4080",
    "editor.lineHighlightBackground": "#2a2a3f",
    "editor.lineHighlightBorder": "#313244",
    "editorCursor.foreground": "#f5c2e7",
    "editorWhitespace.foreground": "#31324480",
    "editorIndentGuide.background1": "#313244",
    "editorIndentGuide.activeBackground1": "#585b70",
    "editorRuler.foreground": "#313244",
    "editorBracketMatch.background": "#363659",
    "editorBracketMatch.border": "#89b4fa",
    "editorGutter.background": "#1e1e2e",
    "editorGutter.addedBackground": "#a6e3a1",
    "editorGutter.deletedBackground": "#f38ba8",
    "editorGutter.modifiedBackground": "#89b4fa",

    // ─── Editor Groups & Tabs ────────────────────────────────────────
    "editorGroup.border": "#11111b",
    "editorGroupHeader.tabsBackground": "#181825",
    "editorGroupHeader.noTabsBackground": "#181825",
    "tab.activeBackground": "#1e1e2e",
    "tab.activeForeground": "#cdd6f4",
    "tab.border": "#11111b",
    "tab.activeBorder": "#89b4fa",
    "tab.activeBorderTop": "#00000000",
    "tab.inactiveBackground": "#181825",
    "tab.inactiveForeground": "#585b70",
    "tab.unfocusedActiveForeground": "#cdd6f460",
    "tab.unfocusedInactiveForeground": "#585b7080",
    "tab.hoverBackground": "#1e1e2e",

    // ─── Status Bar ──────────────────────────────────────────────────
    "statusBar.background": "#181825",
    "statusBar.foreground": "#cdd6f4",
    "statusBar.border": "#11111b",
    "statusBar.debuggingBackground": "#f38ba8",
    "statusBar.debuggingForeground": "#1e1e2e",
    "statusBar.noFolderBackground": "#313244",
    "statusBarItem.remoteBackground": "#89b4fa",
    "statusBarItem.remoteForeground": "#1e1e2e",
    "statusBarItem.hoverBackground": "#31324480",

    // ─── Title Bar ───────────────────────────────────────────────────
    "titleBar.activeBackground": "#11111b",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveBackground": "#11111b",
    "titleBar.inactiveForeground": "#585b70",
    "titleBar.border": "#11111b",

    // ─── Input ───────────────────────────────────────────────────────
    "input.background": "#313244",
    "input.border": "#45475a",
    "input.foreground": "#cdd6f4",
    "input.placeholderForeground": "#585b70",
    "inputOption.activeBackground": "#89b4fa30",
    "inputOption.activeBorder": "#89b4fa",
    "inputValidation.errorBackground": "#f38ba820",
    "inputValidation.errorBorder": "#f38ba8",
    "inputValidation.infoBackground": "#89b4fa20",
    "inputValidation.infoBorder": "#89b4fa",
    "inputValidation.warningBackground": "#f9e2af20",
    "inputValidation.warningBorder": "#f9e2af",

    // ─── Buttons ─────────────────────────────────────────────────────
    "button.background": "#89b4fa",
    "button.foreground": "#1e1e2e",
    "button.hoverBackground": "#b4d0fe",
    "button.secondaryBackground": "#313244",
    "button.secondaryForeground": "#cdd6f4",
    "button.secondaryHoverBackground": "#45475a",

    // ─── Dropdowns / Select ──────────────────────────────────────────
    "dropdown.background": "#313244",
    "dropdown.border": "#45475a",
    "dropdown.foreground": "#cdd6f4",
    "dropdown.listBackground": "#1e1e2e",

    // ─── Lists ───────────────────────────────────────────────────────
    "list.activeSelectionBackground": "#363659",
    "list.activeSelectionForeground": "#cdd6f4",
    "list.dropBackground": "#363659",
    "list.focusBackground": "#2a2a4080",
    "list.focusForeground": "#cdd6f4",
    "list.highlightForeground": "#89b4fa",
    "list.hoverBackground": "#31324450",
    "list.hoverForeground": "#cdd6f4",
    "list.inactiveSelectionBackground": "#31324480",
    "list.inactiveSelectionForeground": "#cdd6f4",
    "list.invalidItemForeground": "#f38ba8",

    // ─── Notifications ───────────────────────────────────────────────
    "notifications.background": "#313244",
    "notifications.border": "#45475a",
    "notifications.foreground": "#cdd6f4",
    "notificationToast.border": "#45475a",
    "notificationsErrorIcon.foreground": "#f38ba8",
    "notificationsWarningIcon.foreground": "#f9e2af",
    "notificationsInfoIcon.foreground": "#89b4fa",

    // ─── Panels ──────────────────────────────────────────────────────
    "panel.background": "#181825",
    "panel.border": "#11111b",
    "panelTitle.activeBorder": "#89b4fa",
    "panelTitle.activeForeground": "#cdd6f4",
    "panelTitle.inactiveForeground": "#585b70",

    // ─── Terminal ────────────────────────────────────────────────────
    "terminal.background": "#1e1e2e",
    "terminal.foreground": "#cdd6f4",
    "terminal.ansiBlack": "#45475a",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiMagenta": "#f5c2e7",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiWhite": "#bac2de",
    "terminal.ansiBrightBlack": "#585b70",
    "terminal.ansiBrightRed": "#f38ba8",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiBrightYellow": "#f9e2af",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiBrightMagenta": "#f5c2e7",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiBrightWhite": "#a6adc8",
    "terminal.selectionBackground": "#58587040",
    "terminalCursor.background": "#1e1e2e",
    "terminalCursor.foreground": "#f5c2e7",

    // ─── Git Decorations ─────────────────────────────────────────────
    "gitDecoration.addedResourceForeground": "#a6e3a1",
    "gitDecoration.modifiedResourceForeground": "#89b4fa",
    "gitDecoration.deletedResourceForeground": "#f38ba8",
    "gitDecoration.untrackedResourceForeground": "#a6e3a1",
    "gitDecoration.ignoredResourceForeground": "#45475a",
    "gitDecoration.conflictingResourceForeground": "#fab387",
    "gitDecoration.submoduleResourceForeground": "#94e2d5",

    // ─── Diff Editor ─────────────────────────────────────────────────
    "diffEditor.insertedTextBackground": "#a6e3a120",
    "diffEditor.removedTextBackground": "#f38ba820",
    "diffEditor.insertedLineBackground": "#a6e3a110",
    "diffEditor.removedLineBackground": "#f38ba810",
    "diffEditor.diagonalFill": "#31324480",

    // ─── Scrollbar ───────────────────────────────────────────────────
    "scrollbar.shadow": "#11111b",
    "scrollbarSlider.activeBackground": "#585b7080",
    "scrollbarSlider.background": "#45475a40",
    "scrollbarSlider.hoverBackground": "#45475a60",

    // ─── Peek View ───────────────────────────────────────────────────
    "peekView.border": "#89b4fa",
    "peekViewEditor.background": "#181825",
    "peekViewEditor.matchHighlightBackground": "#f9e2af30",
    "peekViewResult.background": "#11111b",
    "peekViewResult.fileForeground": "#cdd6f4",
    "peekViewResult.lineForeground": "#a6adc8",
    "peekViewResult.matchHighlightBackground": "#f9e2af30",
    "peekViewResult.selectionBackground": "#363659",
    "peekViewResult.selectionForeground": "#cdd6f4",
    "peekViewTitle.background": "#181825",
    "peekViewTitleDescription.foreground": "#a6adc8",
    "peekViewTitleLabel.foreground": "#cdd6f4",

    // ─── Breadcrumbs ─────────────────────────────────────────────────
    "breadcrumb.activeSelectionForeground": "#cdd6f4",
    "breadcrumb.background": "#1e1e2e",
    "breadcrumb.focusForeground": "#cdd6f4",
    "breadcrumb.foreground": "#585b70",
    "breadcrumbPicker.background": "#313244",

    // ─── Quick Picker ────────────────────────────────────────────────
    "quickInput.background": "#313244",
    "quickInput.foreground": "#cdd6f4",
    "quickInputList.focusBackground": "#363659",
    "quickInputTitle.background": "#313244",
    "pickerGroup.border": "#89b4fa",
    "pickerGroup.foreground": "#89b4fa",

    // ─── Widgets ─────────────────────────────────────────────────────
    "widget.shadow": "#11111b",
    "editorWidget.background": "#313244",
    "editorWidget.border": "#45475a",
    "editorWidget.foreground": "#cdd6f4",
    "editorSuggestWidget.background": "#313244",
    "editorSuggestWidget.border": "#45475a",
    "editorSuggestWidget.foreground": "#cdd6f4",
    "editorSuggestWidget.highlightForeground": "#89b4fa",
    "editorSuggestWidget.selectedBackground": "#363659",
    "editorHoverWidget.background": "#313244",
    "editorHoverWidget.border": "#45475a",

    // ─── Errors & Warnings ───────────────────────────────────────────
    "editorError.foreground": "#f38ba8",
    "editorWarning.foreground": "#f9e2af",
    "editorInfo.foreground": "#89b4fa",
    "editorHint.foreground": "#94e2d5",
    "problemsErrorIcon.foreground": "#f38ba8",
    "problemsWarningIcon.foreground": "#f9e2af",
    "problemsInfoIcon.foreground": "#89b4fa",

    // ─── Extensions ──────────────────────────────────────────────────
    "extensionButton.prominentBackground": "#89b4fa",
    "extensionButton.prominentForeground": "#1e1e2e",
    "extensionButton.prominentHoverBackground": "#b4d0fe",
    "extensionBadge.remoteBackground": "#89b4fa",
    "extensionBadge.remoteForeground": "#1e1e2e",

    // ─── Misc ────────────────────────────────────────────────────────
    "focusBorder": "#89b4fa",
    "foreground": "#cdd6f4",
    "selection.background": "#363659",
    "descriptionForeground": "#a6adc8",
    "errorForeground": "#f38ba8",
    "icon.foreground": "#cdd6f4",
    "toolbar.hoverBackground": "#31324450",
    "toolbar.activeBackground": "#31324480",
    "checkbox.background": "#313244",
    "checkbox.border": "#45475a",
    "checkbox.foreground": "#cdd6f4",
    "badge.background": "#89b4fa",
    "badge.foreground": "#1e1e2e",
    "progressBar.background": "#89b4fa",
    "keybindingLabel.background": "#31324480",
    "keybindingLabel.border": "#45475a",
    "keybindingLabel.bottomBorder": "#45475a",
    "keybindingLabel.foreground": "#cdd6f4",
    "menu.background": "#313244",
    "menu.foreground": "#cdd6f4",
    "menu.selectionBackground": "#363659",
    "menu.selectionForeground": "#cdd6f4",
    "menu.separatorBackground": "#45475a",
    "menu.border": "#45475a",
    "menubar.selectionBackground": "#31324450",
    "menubar.selectionForeground": "#cdd6f4"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#cba6f7",
    "namespace.declaration": "#cba6f7",
    "class": "#f38ba8",
    "class.declaration": "#f38ba8",
    "enum": "#f9e2af",
    "interface": "#94e2d5",
    "struct": "#f38ba8",
    "typeParameter": "#fab387",
    "type": "#94e2d5",
    "type.declaration": "#94e2d5",
    "parameter": "#cdd6f4",
    "variable": "#cdd6f4",
    "variable.readonly": "#cba6f7",
    "variable.defaultLibrary": "#89b4fa",
    "property": "#cdd6f4",
    "property.declaration": "#89b4fa",
    "property.readonly": "#cba6f7",
    "enumMember": "#a6e3a1",
    "function": "#89b4fa",
    "function.declaration": "#89b4fa",
    "method": "#89b4fa",
    "method.declaration": "#89b4fa",
    "macro": "#f38ba8",
    "label": "#cdd6f4",
    "comment": "#6c7086",
    "string": "#a6e3a1",
    "keyword": "#cba6f7",
    "number": "#fab387",
    "operator": "#89dceb",
    "decorator": "#f5c2e7",
    "regexp": "#f38ba8",
    "selfParameter": {
      "foreground": "#f38ba8",
      "fontStyle": "italic"
    },
    "clsParameter": {
      "foreground": "#f38ba8",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    // ─── Comments ──────────────────────────────────────────────────
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6c7086",
        "fontStyle": "italic"
      }
    },

    // ─── Strings ───────────────────────────────────────────────────
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.string.template"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },

    // ─── Numbers, Booleans, Constants ──────────────────────────────
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Boolean / Null / Undefined",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Other Constants",
      "scope": [
        "constant.other",
        "constant.other.placeholder",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },

    // ─── Keywords ──────────────────────────────────────────────────
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.in",
        "keyword.operator.of",
        "keyword.operator.void",
        "keyword.other.using",
        "keyword.other.async",
        "keyword.other.await"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Storage / Modifier",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.var",
        "keyword.let",
        "keyword.const"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Import / Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },

    // ─── Operators ─────────────────────────────────────────────────
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.ternary"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },

    // ─── Functions ─────────────────────────────────────────────────
    {
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Function parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },

    // ─── Classes & Types ───────────────────────────────────────────
    {
      "name": "Class / Type name",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.module",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.type.enum",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Enum member",
      "scope": ["variable.other.enummember"],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },

    // ─── Namespaces / Modules ──────────────────────────────────────
    {
      "name": "Namespace / Module",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.module"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },

    // ─── Variables ─────────────────────────────────────────────────
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Variable — Read-only",
      "scope": [
        "variable.other.constant",
        "variable.other.readonly"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Object property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#f38ba8",
        "fontStyle": "italic"
      }
    },

    // ─── Tags (HTML / JSX / XML) ───────────────────────────────────
    {
      "name": "Tag name",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end",
        "meta.tag.structure.any.html"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },

    // ─── CSS / SCSS ────────────────────────────────────────────────
    {
      "name": "CSS Property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "CSS Value",
      "scope": ["support.constant.property-value.css"],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "CSS Unit",
      "scope": ["keyword.other.unit.css"],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "CSS Selector — Class / ID",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "CSS Pseudo",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "CSS Variable",
      "scope": [
        "variable.css",
        "variable.argument.css",
        "variable.scss"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },

    // ─── Decorators / Annotations ──────────────────────────────────
    {
      "name": "Decorator / Annotation",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#f5c2e7",
        "fontStyle": "italic"
      }
    },

    // ─── Regular Expressions ───────────────────────────────────────
    {
      "name": "RegExp",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "RegExp — Group",
      "scope": [
        "punctuation.definition.group.regexp",
        "keyword.operator.or.regexp"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },

    // ─── Punctuation ───────────────────────────────────────────────
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },

    // ─── Markdown ──────────────────────────────────────────────────
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#89b4fa",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "punctuation.definition.bold.markdown"],
      "settings": {
        "foreground": "#f9e2af",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "punctuation.definition.italic.markdown"],
      "settings": {
        "foreground": "#f5c2e7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#89b4fa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote", "punctuation.definition.quote.begin.markdown"],
      "settings": {
        "foreground": "#94e2d5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list bullet",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.bullet"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },

    // ─── JSON ──────────────────────────────────────────────────────
    {
      "name": "JSON Key",
      "scope": [
        "support.type.property-name.json",
        "meta.object-literal.key.json",
        "string.quoted.double.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },

    // ─── Shell / Bash ──────────────────────────────────────────────
    {
      "name": "Shell variable",
      "scope": ["variable.other.normal.shell", "variable.other.bracket.shell"],
      "settings": {
        "foreground": "#cba6f7"
      }
    },

    // ─── Invalid / Deprecated ─────────────────────────────────────
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": {
        "foreground": "#f38ba8",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#f9e2af",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
